{
    "name": "lingner/typo3-mcp-server",
    "type": "typo3-cms-extension",
    "description": "TYPO3 12.4 backport of hn/typo3-mcp-server: a Model Context Protocol (MCP) server for interacting with TYPO3 pages and records",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/lingnerweb/typo3-mcp-server",
    "authors": [
        {
            "name": "Marco Pfeiffer",
            "email": "marco@hauptsache.net"
        },
        {
            "name": "LINGNER",
            "homepage": "https://github.com/lingnerweb",
            "role": "TYPO3 12 backport"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-zip": "*",
        "logiscape/mcp-sdk-php": "^2.0",
        "typo3/cms-backend": "^12.4 || ^13.4 || ^14.3",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.3",
        "typo3/cms-workspaces": "^12.4 || ^13.4 || ^14.3"
    },
    "replace": {
        "hn/typo3-mcp-server": "self.version"
    },
    "require-dev": {
        "typo3/testing-framework": "^8.2 || ^9.2",
        "typo3/cms-install": "^12.4 || ^13.4 || ^14.3",
        "georgringer/news": "^12.3 || ^14.0",
        "b13/container": "^3.2 || ^4.0",
        "brianium/paratest": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Hn\\McpServer\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hn\\McpServer\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "mcp_server"
        }
    },
    "scripts": {
        "setup": [
            "bash Build/setup-typo3.sh"
        ],
        "post-install-cmd": [
            "@setup"
        ],
        "post-update-cmd": [
            "@setup"
        ],
        "test": [
            "@test:functional"
        ],
        "test:functional": [
            "paratest -c phpunit.xml.dist"
        ],
        "test:llm": [
            "rm -rf .Build/llm-stats",
            "rm -f .Build/llm-retries.log",
            "paratest -c Tests/Llm/phpunit-llm.xml --testdox --no-progress -p 5 --log-junit .Build/llm-results.xml || true",
            "php Build/check-llm-results.php --min-pass=3"
        ],
        "build:ter": "bash Build/build-ter.sh"
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    }
}
